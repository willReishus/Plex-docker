# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds passwords and keys. It is in .gitignore; never upload or share it.

# ----------------------------------------------------------------- basics (docs/02)
# Your Linux user's ids. Find them with:  id -u   and   id -g
PUID=1000
PGID=1000
# Your time zone, e.g. America/Chicago, America/New_York, Europe/London
TZ=America/Chicago

# The server's fixed address on your home network (docs/01 shows how to reserve it)
SERVER_IP=192.168.1.50
# A name for the dashboard title
SERVER_NAME=Media Server

# Where app settings live (small; keep on the main SSD). ./appdata = inside this folder.
APPDATA_DIR=./appdata
# The big media drive, mounted in docs/01. Holds torrents/ and media/.
DATA_DIR=/mnt/data

# Port other torrent users connect to. Forward it on your router for better speeds.
TORRENT_PORT=6881

# Only for Plex's very first start: get one at https://plex.tv/claim (expires in 4 minutes).
# Leave blank afterwards.
PLEX_CLAIM=

# ----------------------------------------------------------------- upgrades
# Which upgrades are switched on. The core always runs. Add names separated by commas, e.g.
#   COMPOSE_PROFILES=requests,quality,dashboard
# Choices: requests, quality, kometa, tunarr, dashboard, dns, trackers
COMPOSE_PROFILES=

# Hardware transcoding / second drive (docs/07). Leave as-is unless a doc tells you to change it.
#   Intel graphics:  COMPOSE_FILE=compose.yaml:extras/gpu-intel.yaml
#   NVIDIA card:     COMPOSE_FILE=compose.yaml:extras/gpu-nvidia.yaml
#   Add a second drive by appending :extras/second-drive.yaml
COMPOSE_FILE=compose.yaml
# Only used with extras/second-drive.yaml
DATA2_DIR=

# ----------------------------------------------------------------- keys and passwords
# scripts/collect-keys.py fills the API keys in for you once the apps have started.
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
SEERR_API_KEY=
TAUTULLI_API_KEY=
PLEX_TOKEN=

# The qBittorrent web login you choose in docs/02.
# Use letters, numbers, - and _ only in passwords here (no spaces, quotes, # or $).
QBIT_USER=admin
QBIT_PASS=

# Free key from https://www.themoviedb.org/settings/api (docs/04, Kometa)
TMDB_API_KEY=

# Prowlarr ids of the private trackers cross-seed should search, e.g. 3,5,8 (docs/06)
CROSS_SEED_INDEXER_IDS=
